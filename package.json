{
  "name": "@jaggr2/cdk-cf-dns",
  "version": "0.1.0",
  "description": "Manage Cloudflare DNS records as CloudFormation resources from AWS CDK, so Route 53 hosted zones are no longer needed.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "API.md"
  ],
  "license": "MIT",
  "keywords": [
    "aws",
    "cdk",
    "cloudformation",
    "cloudflare",
    "dns",
    "route53"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jaggr2/cdk-cf-dns.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:update": "jest -u",
    "lint": "eslint . --ext .ts",
    "docs": "ts-node scripts/generate-api-md.ts",
    "package": "npm run build && npm pack"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.x",
    "constructs": "^10.x"
  },
  "devDependencies": {
    "@aws-sdk/client-acm": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
